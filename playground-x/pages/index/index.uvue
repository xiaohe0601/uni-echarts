<template>
  <scroll-view class="page" direction="vertical">
    <view class="nav-spacer" :style="navSpacerStyle"></view>

    <view class="hero">
      <image class="logo" src="/static/uni-echarts.png" mode="aspectFit" />
      <text class="title">Uni ECharts</text>
      <text class="subtitle">适用于 uni-app 的 Apache ECharts 组件</text>
    </view>

    <view class="menu-wrap">
      <view class="menu">
        <view
          v-for="(item, index) in demos"
          :key="item.path"
          class="menu-row"
          :class="{ 'menu-row--last': index === demos.length - 1 }"
          @click="open(item.path)"
        >
          <text class="menu-title">{{ item.title }}</text>
          <text class="menu-arrow">❯</text>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="ts">
const demos = [
  { title: "基础用法", path: "/pages/examples/basic/index" },
  { title: "异步数据", path: "/pages/examples/async-data/index" },
  { title: "动作调度", path: "/pages/examples/action-dispatch/index" },
  { title: "内置主题", path: "/pages/examples/builtin-theme/index" },
  { title: "颜色渐变", path: "/pages/examples/gradient/index" },
  { title: "弹窗内使用", path: "/pages/examples/popup/index" },
  { title: "Pinia 集成", path: "/pages/examples/pinia-integration/index" },
  { title: "图表联动", path: "/pages/examples/connectable/index" },
  { title: "手动更新", path: "/pages/examples/manual-update/index" },
  { title: "自定义 Tooltip", path: "/pages/examples/custom-tooltip/index" },
  { title: "保存为图片", path: "/pages/examples/export-image/index" },
]

const statusBarHeight = Number(uni.getWindowInfo().statusBarHeight || 0)
const navSpacerStyle = `height:${statusBarHeight + 44}px`

function open(path: string) {
  uni.navigateTo({
    url: path,
  })
}
</script>

